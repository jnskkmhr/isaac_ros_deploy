load("@isaac_ros2_rules//ros:defs.bzl", "ament_index_share_files")
load("//workspace/shared/pkg:ros_pkg.bzl", "ros")

package(default_visibility = ["//visibility:public"])

# Apply the add_g1_29_dof_with_hand patch to upstream MJCF files.
genrule(
    name = "patch_mjcf",
    srcs = [
        "@unitree_mujoco//:g1_29dof.xml",
        "@unitree_mujoco//:scene_29dof.xml",
        "//workspace/shared/third_party/unitree_g1_description:patches/add_g1_29_dof_with_hand.patch",
    ],
    outs = [
        "mjcf/g1_29dof.xml",
        "mjcf/g1_29dof_with_hand.xml",
        "mjcf/scene_29dof.xml",
        "mjcf/scene_29dof_with_hand.xml",
    ],
    cmd = " && ".join([
        "WORK=$(@D)/patch_work",
        "mkdir -p $$WORK/unitree_robots/g1",
        "cp $(location @unitree_mujoco//:g1_29dof.xml) $$WORK/unitree_robots/g1/g1_29dof.xml",
        "cp $(location @unitree_mujoco//:scene_29dof.xml) $$WORK/unitree_robots/g1/scene_29dof.xml",
        "(patch --forward --reject-file=/dev/null -p0 -d $$WORK -i $$(pwd)/$(location //workspace/shared/third_party/unitree_g1_description:patches/add_g1_29_dof_with_hand.patch))",
        "test -f $$WORK/unitree_robots/g1/g1_29dof_with_hand.xml",
        "test -f $$WORK/unitree_robots/g1/scene_29dof_with_hand.xml",
        "for f in g1_29dof.xml g1_29dof_with_hand.xml scene_29dof.xml scene_29dof_with_hand.xml; do sed 's|meshdir=\"meshes\"|meshdir=\"../meshes\"|g' $$WORK/unitree_robots/g1/$$f > $(@D)/mjcf/$$f; done",
    ]),
)

# Fix URDF mesh paths.
genrule(
    name = "fix_urdf",
    srcs = ["@unitree_ros//:g1_29dof_with_hand_rev_1_0.urdf"],
    outs = ["urdf/g1_29dof_with_hand_rev_1_0_fixed.urdf"],
    cmd = "sed -e 's|filename=\"meshes/|filename=\"package://unitree_g1_description/meshes/|g' -e 's/_rev_1_0\\.STL/.STL/g' $< > $@",
)

# Also expose the official 29-joint description with fixed rubber hands.
genrule(
    name = "fix_urdf_no_hands",
    srcs = ["@unitree_ros//:g1_29dof_rev_1_0.urdf"],
    outs = ["urdf/g1_29dof_rev_1_0_fixed.urdf"],
    cmd = "sed -e 's|filename=\"meshes/|filename=\"package://unitree_g1_description/meshes/|g' -e 's/_rev_1_0\\.STL/.STL/g' $< > $@",
)


<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
 <xacro:macro name="mujoco_joint" params="name initial_position:=0.0">
  <joint name="${name}">
   <command_interface name="position" />
   <command_interface name="velocity" />
   <command_interface name="effort" />
   <command_interface name="kp" />
   <command_interface name="kd" />
   <state_interface name="position">
    <param name="initial_value">${initial_position}</param>
   </state_interface>
   <state_interface name="velocity" />
   <state_interface name="effort" />
  </joint>
 </xacro:macro>
 <xacro:macro name="g1_ros2_control" params="mujoco_model_path enable_viewer:=true">
  <ros2_control name="MujocoSystem" type="system">
   <hardware>
    <plugin>mujoco_ros2_control/MujocoSystemInterface</plugin>
    <param name="mujoco_model">${mujoco_model_path}</param>
    <param name="headless">${'false' if str(enable_viewer).lower() == 'true' else 'true'}</param>
    <param name="sim_speed_factor">1.0</param>
    <param name="lockstep">true</param>
    <param name="lockstep_timestep">0.001</param>
    <param name="lockstep_steps_per_update">5</param>
    <param name="odom_frame">world</param>
    <param name="camera_publish_rate">30.0</param>
    <param name="auto_register_cameras">false</param>
   </hardware>
   <xacro:mujoco_joint name="left_hip_pitch_joint" initial_position="-0.31200000643730164" />
   <xacro:mujoco_joint name="right_hip_pitch_joint" initial_position="-0.31200000643730164" />
   <xacro:mujoco_joint name="waist_yaw_joint" initial_position="0.0" />
   <xacro:mujoco_joint name="left_hip_roll_joint" initial_position="0.0" />
   <xacro:mujoco_joint name="right_hip_roll_joint" initial_position="0.0" />
   <xacro:mujoco_joint name="waist_roll_joint" initial_position="0.0" />
   <xacro:mujoco_joint name="left_hip_yaw_joint" initial_position="0.0" />
   <xacro:mujoco_joint name="right_hip_yaw_joint" initial_position="0.0" />
   <xacro:mujoco_joint name="waist_pitch_joint" initial_position="0.0" />
   <xacro:mujoco_joint name="left_knee_joint" initial_position="0.6690000295639038" />
   <xacro:mujoco_joint name="right_knee_joint" initial_position="0.6690000295639038" />
   <xacro:mujoco_joint name="left_shoulder_pitch_joint" initial_position="0.20000000298023224" />
   <xacro:mujoco_joint name="right_shoulder_pitch_joint" initial_position="0.20000000298023224" />
   <xacro:mujoco_joint name="left_ankle_pitch_joint" initial_position="-0.3630000054836273" />
   <xacro:mujoco_joint name="right_ankle_pitch_joint" initial_position="-0.3630000054836273" />
   <xacro:mujoco_joint name="left_shoulder_roll_joint" initial_position="0.20000000298023224" />
   <xacro:mujoco_joint name="right_shoulder_roll_joint" initial_position="-0.20000000298023224" />
   <xacro:mujoco_joint name="left_ankle_roll_joint" initial_position="0.0" />
   <xacro:mujoco_joint name="right_ankle_roll_joint" initial_position="0.0" />
   <xacro:mujoco_joint name="left_shoulder_yaw_joint" initial_position="0.0" />
   <xacro:mujoco_joint name="right_shoulder_yaw_joint" initial_position="0.0" />
   <xacro:mujoco_joint name="left_elbow_joint" initial_position="0.6000000238418579" />
   <xacro:mujoco_joint name="right_elbow_joint" initial_position="0.6000000238418579" />
   <xacro:mujoco_joint name="left_wrist_roll_joint" initial_position="0.0" />
   <xacro:mujoco_joint name="right_wrist_roll_joint" initial_position="0.0" />
   <xacro:mujoco_joint name="left_wrist_pitch_joint" initial_position="0.0" />
   <xacro:mujoco_joint name="right_wrist_pitch_joint" initial_position="0.0" />
   <xacro:mujoco_joint name="left_wrist_yaw_joint" initial_position="0.0" />
   <xacro:mujoco_joint name="right_wrist_yaw_joint" initial_position="0.0" />
   <sensor name="imu">
    <param name="mujoco_type">imu</param>
    <state_interface name="orientation.x" />
    <state_interface name="orientation.y" />
    <state_interface name="orientation.z" />
    <state_interface name="orientation.w" />
    <state_interface name="angular_velocity.x" />
    <state_interface name="angular_velocity.y" />
    <state_interface name="angular_velocity.z" />
    <state_interface name="linear_acceleration.x" />
    <state_interface name="linear_acceleration.y" />
    <state_interface name="linear_acceleration.z" />
   </sensor>
  </ros2_control>
 </xacro:macro>
</robot>
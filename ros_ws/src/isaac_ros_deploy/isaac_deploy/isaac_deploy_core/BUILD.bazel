# Preserve the existing dependency target while sourcing tl::expected from rcpputils.
cc_library(
    name = "tl_expected",
    defines = ["ISAAC_DEPLOY_USE_BUNDLED_TL_EXPECTED"],
    deps = ["@ros2packages//rcpputils:cc_lib"],
)

ros2_cc_library(
    name = "expected",
    hdrs = [
        "core/error.hpp",
    ],
    copts = ["-std=c++20"],
    include_prefix = "isaac_deploy_core",
    includes = ["."],
    deps = [":tl_expected"],
)

ros2_cc_library(
    name = "types",
    hdrs = [
        "core/error.hpp",
        "core/types.hpp",
    ],
    copts = ["-std=c++20"],
    include_prefix = "isaac_deploy_core",
    includes = ["."],
    deps = [
        ":expected",
        "@libtorch",

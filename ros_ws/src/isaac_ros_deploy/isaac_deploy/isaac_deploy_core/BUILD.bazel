load(
    "@isaac_ros2_rules//ros:defs.bzl",
    "ament_index_share_files",
    "ros2_cc_library",
    "ros2_cc_shared_library",
    "ros2_cc_test",
    "ros_ws",
)
load("//workspace/shared/build:utils.bzl", "BASE_ROS_PACKAGE_FILES", "ament_index_paths", "load_paths")
load("//workspace/shared/pip/pytorch:load_paths.bzl", "torch_debian_runtime_rpaths")
load("//workspace/shared/pkg:ros_pkg.bzl", "ros")

package(
    default_visibility = ["//visibility:public"],
    features = ["c++20"],
)

ros_ws(
    name = "ros_ws",
    ament_index_paths = ament_index_paths(add_nvvpi_paths = True),
    files = BASE_ROS_PACKAGE_FILES + [
        "//workspace/shared/third_party/cuda",
        "@hpcx",
        "@libnvvpi4//:files",
        "@nvidia//datacenter-gpu-manager-4-core:files",
        "@ros2packages//rcpputils:files",
        "@triton_core_260//:files",
    ],
    load_paths = load_paths(
        add_cuda_paths = True,
        add_nvvpi_paths = True,
        add_triton_paths = True,
    ),
)

ament_index_share_files(
    name = "isaac_deploy_core_pkg",
    package_name = "isaac_deploy_core",
    srcs = ["package.xml"] + glob([
        "test_data/**/*",
        "scripts/**/*",
        "cmake/**/*",
    ]),
    libraries = [
        ":yaml_cpp_so",
        ":config_parser_so",
        ":inference_controller_so",
        ":inference_runner_so",
        ":input_builder_so",
        ":input_term_so",
        ":mock_runner_so",
        ":output_builder_so",
        ":output_term_so",
        ":safetensors_loader_so",
        ":tensor_utils_so",
        ":triton_runner_so",
    ],
)

filegroup(
    name = "test_data",
    srcs = glob(["test_data/**"]),
)


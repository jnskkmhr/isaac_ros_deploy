    libs = [
        ":config_parser_so",
        ":yaml_cpp_so",
        ":inference_controller_so",
        ":inference_runner_so",
        ":input_builder_so",
        ":input_term_so",
        ":mock_runner_so",
        ":output_builder_so",
        ":output_term_so",
        ":safetensors_loader_so",
        ":tensor_utils_so",
        ":triton_runner_so",
    ],
    runtime_rpaths = torch_debian_runtime_rpaths(),
    share_srcs = glob([
        "cmake/**",
        "scripts/**",

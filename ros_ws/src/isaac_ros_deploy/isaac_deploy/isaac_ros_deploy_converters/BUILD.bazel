genrule(
    name = "cmake_export_files",
    outs = [
        "cmake/ament_cmake_export_targets-extras.cmake",
        "cmake/isaac_ros_deploy_converters_targetsExport-release.cmake",
        "cmake/isaac_ros_deploy_converters_targetsExport.cmake",
    ],
    cmd = """
mkdir -p $(RULEDIR)/cmake
printf 'include("$${CMAKE_CURRENT_LIST_DIR}/isaac_ros_deploy_converters_targetsExport.cmake")\\n' > $(RULEDIR)/cmake/ament_cmake_export_targets-extras.cmake
: > $(RULEDIR)/cmake/isaac_ros_deploy_converters_targetsExport-release.cmake
: > $(RULEDIR)/cmake/isaac_ros_deploy_converters_targetsExport.cmake
""",
)

